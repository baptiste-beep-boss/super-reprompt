{
  "description": "super-reprompt: H1 suggests framing a large request (one line, never blocks), H2 re-injects a short mission reminder after compaction or resume, H3 gates the end of an executing mission. All three fail open and stay silent unless relevant. Set SUPER_REPROMPT_HOOKS=0 to turn them off.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_suggest.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_suggest.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_suggest.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_compact.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_compact.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_compact.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\"; exit 0",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
